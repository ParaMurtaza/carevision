# Copy this file to ".env" and fill in the values. NEVER commit .env to GitHub.
PORT=5000
NODE_ENV=development
# Local MongoDB OR your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/carevision
# Any long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Allowed browser origins (comma separated). Same-origin deployment needs nothing here.
CLIENT_ORIGIN=http://localhost:5000

# --- AI agents: FREE open-source LLM running on your own computer (no API key, no cost) ---
# 1) install Ollama from https://ollama.com   2) ollama pull llama3.2:3b   3) ollama pull gemma3:4b   4) npm run ai:check
# Defaults below work with Ollama as-is; you normally do not need to change anything.
LLM_BASE_URL=http://localhost:11434/v1
LLM_TEXT_MODEL=llama3.2:3b
LLM_VISION_MODEL=gemma3:4b
# Only needed if you point LLM_BASE_URL at a hosted service (Groq, OpenRouter ...). Ollama ignores it.
LLM_API_KEY=
# Set to false to force the basic rule-based mode (no AI at all)
LLM_ENABLED=true
# Local models can be slow on a laptop. Milliseconds to wait for one answer:
LLM_TIMEOUT_MS=180000

# --- Admin account created by "npm run seed". SET A STRONG PASSWORD before publishing! ---
ADMIN_EMAIL=admin@carevision.test
ADMIN_PASSWORD=Admin@123
